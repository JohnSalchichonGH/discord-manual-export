{
  "manifest_version": 3,
  "name": "Discord Manual Export",
  "version": "1.0.0",
  "description": "Manually scroll Discord and export messages to JSON/text/DCE. Local-only, no network; optional High-fidelity mode reads page state.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manual Export"
  },
  "permissions": ["scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/channels/*",
        "https://canary.discord.com/channels/*",
        "https://ptb.discord.com/channels/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
