{
  "manifest_version": 3,
  "name": "Discord Manual Export",
  "version": "1.1.0",
  "description": "Manually scroll Discord and export messages to JSON/text/DCE. Local-only, no network; optional High-fidelity mode reads page state.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Manual Export",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "permissions": ["scripting", "activeTab"],
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://canary.discord.com/*",
        "https://ptb.discord.com/*"
      ],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
